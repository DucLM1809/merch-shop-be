# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merch_shop"

# Auth
JWT_SECRET="replace-with-openssl-rand-base64-32"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_HOURS=1
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# First admin account, seeded via `npm run seed:admin`
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-please-min-12-chars"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="orders@yourdomain.com"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"

# Guest cart TTL in days
GUEST_CART_TTL_DAYS=7
